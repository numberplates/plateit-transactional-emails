# Set to false to skip signature verification when testing the listener.
WEBHOOK_VERIFY_SIGNATURE=true

# COMPANY 1 - EXAMPLE PLATES
COMPANY_1_WEBHOOK_SECRET=replace-with-signing-secret
COMPANY_1_EMAIL_ADDRESS_FROM=support@exampleplates.com
COMPANY_1_EMAIL_ADDRESS_BOUNCE=bounces@exampleplates.com
COMPANY_1_SMTP_SERVER=smtp.exampleplates.com
COMPANY_1_SMTP_USER=support@exampleplates.com
COMPANY_1_SMTP_PASSWORD=replace-with-smtp-password
COMPANY_1_SMTP_PORT=465
COMPANY_1_SMTP_ENCRYPTION=smtps
# COMPANY_1_RELAY_ORDER_PLACE_URL=
# COMPANY_1_RELAY_ORDER_PACKAGE_STATUS_UPDATE_URL=
# COMPANY_1_RELAY_ORDER_DOCUMENT_STATUS_UPDATE_URL=

# COMPANY 2 - DEMO PLATES
COMPANY_2_WEBHOOK_SECRET=replace-with-another-signing-secret
COMPANY_2_EMAIL_ADDRESS_FROM=support@demoplates.com
COMPANY_2_EMAIL_ADDRESS_BOUNCE=bounces@demoplates.com
COMPANY_2_SMTP_SERVER=smtp.demoplates.com
COMPANY_2_SMTP_USER=support@demoplates.com
COMPANY_2_SMTP_PASSWORD=replace-with-smtp-password
COMPANY_2_SMTP_PORT=465
COMPANY_2_SMTP_ENCRYPTION=smtps
